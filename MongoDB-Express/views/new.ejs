<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New chat</title>
</head>
<body>
    <h3>Write new chat</h3>
    <form method="POST" action="/chats">
        <input placeholder="from" name="from" ><br><br><br>
        <input placeholder="to" name="to"><br><br><br>
        <textarea name="msg" rows="10" cols="30" placeholder="Type your msg..."></textarea><br><br><br>
        <button>Submit</button>
    </form>
</body>
</html>