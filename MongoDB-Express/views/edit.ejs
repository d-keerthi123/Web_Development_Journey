<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Form</title>
</head>
<body>
    <h3>Edit you Chat! <%=chat._id%></h3>
    <p> Chat from <%=chat.from%> to <%=chat.to%> </p>
    <form method="POST" action="/chats/<%=chat._id%>?_method=PUT">
        <textarea name="msg" rows="10" cols="30"> <%=chat.msg%> </textarea><br><br><br>
        <button>Submit</button>
    </form>
</body>
</html>