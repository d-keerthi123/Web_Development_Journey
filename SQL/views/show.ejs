<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Users</title>
    <style>
        table,tr,th,td{
            border: 2px solid black;
        }
    </style>
</head>
<body>
    <h1>All users</h1>
    <table>
        <tr>
            <th>Id</th>
            <th>username</th>
            <th>email</th>
        </tr>
        <% for(let user of result){ %>
            <tr>
                <td> <%=user.id%> </td>
                <td> <%=user.username%> </td>
                <td> <%=user.email%> </td>
                <td>
                    <form method="GET" action="/user/<%=user.id%>/edit">
                    <button>Edit Username</button>
                    </form>
                </td>
            </tr>
            
        <%}%>
    </table>
</body>
</html>